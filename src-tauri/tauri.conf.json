{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitpane",
  "version": "0.1.0",
  "identifier": "dev.gitpane.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gitpane",
        "width": 1320,
        "height": 850,
        "minWidth": 860,
        "minHeight": 580,
        "backgroundColor": "#181b1e",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "shortDescription": "熟悉的 Git 操作，更轻的工作空间",
    "category": "DeveloperTool",
    "windows": { "nsis": { "displayLanguageSelector": false, "languages": ["SimpChinese", "English"] } },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
